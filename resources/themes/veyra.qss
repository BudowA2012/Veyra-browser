/* =========================================================
   VEYRA BASE STYLE
   ========================================================= */

QWidget {
    font-family: "Segoe UI";
    font-size: 14px;
}


/* =========================================================
   NAVIGATION
   ========================================================= */

#NavigationBar {
    border: none;
    padding: 6px;
}

#NavigationButton {
    background: transparent;

    border: none;
    border-radius: 10px;

    min-width: 36px;
    max-width: 36px;

    min-height: 36px;
    max-height: 36px;

    padding: 0px;
}


/* =========================================================
   ADDRESS BAR
   ========================================================= */

#AddressBar {
    border-radius: 19px;

    padding-left: 16px;
    padding-right: 16px;

    min-height: 36px;
}


/* =========================================================
   TAB STRIP
   ========================================================= */

#VeyraTabWidget {
    border: none;
}

#VeyraTabStrip {
    border: none;

    min-height: 44px;
    max-height: 44px;
}

#VeyraTabStack {
    border: none;
}


/* =========================================================
   TAB BAR
   ========================================================= */

#VeyraTabBar {
    border: none;

    padding-left: 0px;
}

#VeyraTabBar::tab {
    border: none;
    border-radius: 9px;

    margin-top: 4px;
    margin-bottom: 4px;

    margin-left: 2px;
    margin-right: 2px;

    padding-left: 12px;
    padding-right: 8px;

    min-height: 28px;
}

#VeyraTabBar::icon {
    margin-left: 2px;
    margin-right: 5px;
}


/* =========================================================
   TAB CLOSE BUTTON
   ========================================================= */

#TabCloseButton {
    background: transparent;

    border: none;
    border-radius: 7px;

    min-width: 24px;
    max-width: 24px;

    min-height: 24px;
    max-height: 24px;

    padding: 0px;
    margin: 0px;
}


/* =========================================================
   NEW TAB BUTTON
   ========================================================= */

#TabNewButton {
    border-radius: 9px;

    min-width: 32px;
    max-width: 32px;

    min-height: 32px;
    max-height: 32px;

    padding: 0px;
    margin: 0px;
}


/* =========================================================
   NEW TAB PAGE
   ========================================================= */

#NewTabPage,
#NewTabCenter {
    border: none;
}

#VeyraLogo {
    background: transparent;

    font-size: 72px;
    font-weight: 700;
}

#VeyraSubtitle {
    background: transparent;

    font-size: 18px;
}


/* =========================================================
   NEW TAB SEARCH
   ========================================================= */

#NewTabSearchContainer {
    border-radius: 26px;
}

#NewTabSearch {
    background: transparent;

    border: none;

    padding: 10px 14px;

    font-size: 16px;
}

#NewTabSearch:focus {
    border: none;
}

#NewTabSearchButton {
    border: none;
    border-radius: 18px;

    font-size: 18px;

    min-width: 42px;
    max-width: 42px;

    min-height: 42px;
    max-height: 42px;

    padding: 0px;
}


/* =========================================================
   SHORTCUTS
   ========================================================= */

#ShortcutsTitle {
    background: transparent;

    font-size: 13px;
    font-weight: 600;
}

#ShortcutCard {
    border-radius: 17px;
}

#ShortcutIcon {
    border-radius: 12px;

    font-size: 19px;
    font-weight: 700;
}

#ShortcutName {
    background: transparent;

    font-size: 14px;
    font-weight: 600;
}

#ShortcutMenuButton {
    background: transparent;

    border: none;
    border-radius: 7px;

    font-size: 18px;

    min-width: 26px;
    max-width: 26px;

    min-height: 26px;
    max-height: 26px;

    padding: 0px;
    margin: 0px;
}

#AddShortcutCard {
    background: transparent;

    border-radius: 17px;

    font-size: 14px;
}


/* =========================================================
   SIDEBAR
   ========================================================= */

#Sidebar {
    border: none;
}


/* ================= HEADER ================= */

#SidebarHeader {
    background: transparent;
    border: none;
}


/* ================= VEYRA LOGO ================= */

#SidebarLogo {
    border-radius: 10px;

    font-size: 18px;
    font-weight: 700;
}


/* ================= BRAND ================= */

#SidebarBrand {
    background: transparent;
    border: none;

    font-size: 17px;
    font-weight: 700;
}


/* ================= TOGGLE ================= */

#SidebarToggleButton {
    background: transparent;

    border: none;
    border-radius: 9px;

    padding: 0px;
}


/* ================= SECTION LABEL ================= */

#SidebarSectionLabel {
    background: transparent;

    border: none;

    padding-left: 10px;

    font-size: 10px;
    font-weight: 700;

    letter-spacing: 1px;
}


/* ================= NAVIGATION BUTTON ================= */

#SidebarButton {
    background: transparent;

    border: none;
    border-radius: 11px;

    text-align: left;

    padding-left: 13px;
    padding-right: 10px;

    font-size: 13px;
    font-weight: 500;
}


/* ================= DIVIDER ================= */

#SidebarDivider {
    border: none;

    min-height: 1px;
    max-height: 1px;
}


/* =========================================================
   SETTINGS
   ========================================================= */

#SettingsPage,
#SettingsContainer {
    border: none;
}

#SettingsTitle {
    background: transparent;

    font-size: 36px;
    font-weight: 700;
}

#SettingsSubtitle {
    background: transparent;

    font-size: 15px;
}

#SettingsSection {
    border-radius: 16px;
}

#SettingsSectionTitle {
    background: transparent;

    font-size: 18px;
    font-weight: 600;
}

#SettingsSectionDescription {
    background: transparent;

    font-size: 13px;
}

#SettingsRowTitle {
    background: transparent;

    font-size: 14px;
    font-weight: 600;
}

#SettingsRowDescription {
    background: transparent;

    font-size: 12px;
}


/* =========================================================
   THEME CARDS
   ========================================================= */

#ThemeCard {
    border-radius: 13px;

    text-align: left;
}

#ThemeCardTitle {
    background: transparent;

    font-size: 15px;
    font-weight: 600;
}

#ThemeCardSubtitle {
    background: transparent;

    font-size: 12px;
}


/* =========================================================
   SETTINGS ELEMENTS
   ========================================================= */

#SettingsSeparator {
    border: none;

    min-height: 1px;
    max-height: 1px;
}

#SettingsComboBox {
    border-radius: 9px;

    padding: 8px 14px;

    min-width: 150px;
}

#SettingsComboBox::drop-down {
    border: none;

    width: 26px;
}

#SettingsSwitch {
    spacing: 0px;
}

#SettingsSwitch::indicator {
    width: 42px;
    height: 22px;
}


/* =========================================================
   ABOUT
   ========================================================= */

#AboutTitle {
    background: transparent;

    font-size: 16px;
    font-weight: 600;
}

#AboutText {
    background: transparent;

    font-size: 13px;
}


/* =========================================================
   HISTORY
   ========================================================= */

#HistoryPageTitle {
    background: transparent;

    font-size: 32px;
    font-weight: 700;
}

#HistorySearch {
    border-radius: 14px;

    padding: 12px 16px;
}

#HistoryItem {
    border-radius: 14px;
}

#HistoryTitle {
    background: transparent;

    font-size: 15px;
    font-weight: 600;
}

#HistoryUrl,
#HistoryTime {
    background: transparent;
}

#HistoryOpenButton {
    border-radius: 10px;

    padding: 8px 14px;
}

#HistoryDeleteButton {
    border-radius: 8px;

    min-width: 32px;
    max-width: 32px;

    min-height: 32px;
    max-height: 32px;
}

#HistoryClearButton {
    border-radius: 10px;

    padding: 10px 16px;
}


/* =========================================================
   DOWNLOADS
   ========================================================= */

#DownloadPage,
#DownloadsContainer {
    border: none;
}

#DownloadsTitle {
    background: transparent;

    font-size: 32px;
    font-weight: 700;
}

#DownloadsSubtitle {
    background: transparent;

    font-size: 13px;
}

#DownloadsEmpty {
    background: transparent;

    font-size: 14px;
}

#DownloadsFolderButton {
    border-radius: 9px;

    padding: 8px 14px;
}


/* =========================================================
   DOWNLOAD ITEM
   ========================================================= */

#DownloadItem {
    border-radius: 14px;
}

#DownloadFileName {
    background: transparent;

    font-size: 14px;
    font-weight: 600;
}

#DownloadStatus {
    background: transparent;

    font-size: 12px;
}

#DownloadActionButton,
#DownloadPrimaryButton {
    border-radius: 8px;

    padding: 7px 12px;
}


/* =========================================================
   DOWNLOAD PROGRESS
   ========================================================= */

#DownloadProgress {
    border: none;

    min-height: 5px;
    max-height: 5px;
}

#DownloadProgress::chunk {
    border: none;
    border-radius: 2px;
}


/* =========================================================
   DIALOGS
   ========================================================= */

#ShortcutDialogTitle {
    background: transparent;

    font-size: 22px;
    font-weight: 700;
}

#ShortcutDialogInput {
    border-radius: 10px;

    padding: 9px 12px;
}


/* =========================================================
   QR DIALOG
   ========================================================= */

#QRDialog {
    border: none;
}


/* =========================================================
   GENERIC BUTTON
   ========================================================= */

QPushButton {
    border: none;
    border-radius: 9px;
}

QToolButton {
    border: none;
}


/* =========================================================
   SCROLL AREA
   ========================================================= */

QScrollArea {
    border: none;
}


/* =========================================================
   SCROLLBAR
   ========================================================= */

QScrollBar:vertical {
    background: transparent;

    width: 9px;

    margin: 3px;
}

QScrollBar::handle:vertical {
    border-radius: 4px;

    min-height: 30px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}


/* =========================================================
   LOADING BAR
   ========================================================= */

#BrowserLoadingBar {
    background: transparent;

    border: none;

    min-height: 3px;
    max-height: 3px;
}

#BrowserLoadingBar::chunk {
    border: none;
}


/* =========================================================
   TOOLTIP
   ========================================================= */

QToolTip {
    border-radius: 6px;

    padding: 5px 8px;
}